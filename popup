<div id="contact-modal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="toggleContact()">&times;</span>
        <h2>📩 Envoyer un message</h2>
        <form action="https://formspree.io/f/ton_id" method="POST" enctype="multipart/form-data">
            <input type="email" name="email" placeholder="Votre Email" required>
            <textarea name="message" placeholder="Votre projet ou question..." required></textarea>
            <div class="file-input">
                <label for="file">📎 Joindre un fichier (CV, Cahier des charges...)</label>
                <input type="file" id="file" name="attachment">
            </div>
            <button type="submit" class="btn">Envoyer le message</button>
        </form>
    </div>
</div>
